##Twitch part 
TWITCH_CLIENT_ID= # The CLIENT ID from the Twitch Dev Console
TWITCH_CLIENT_SECRET= # The CLIENT SECRET from the Twitch Dev Console
BOT_ID= # The Account ID of the bot user...(./twitch api get users -q login=yourTwitchAccount)
OWNER_ID= # Your personal User ID..(Same as BOT_ID)

